{
  "version": 2,
  "rewrites": [
    {
      "source": "/(predict|explain|metrics|whatif|plots)/(.*)",
      "destination": "https://${BACKEND_URL}/$1/$2"
    },
    {
      "source": "/(predict|explain|metrics|whatif|plots)",
      "destination": "https://${BACKEND_URL}/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
